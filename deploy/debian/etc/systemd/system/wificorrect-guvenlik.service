[Unit]
Description=WifiCorrect guvenlik duvari ve giris kapisi (kapali-iken-guvenli)
DefaultDependencies=no
Before=network-pre.target
Wants=network-pre.target
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Kurallar yüklenemezse yönlendirme kapalı kalır: müşteri tarafı hiçbir yere geçemez.
ExecStartPre=/usr/sbin/sysctl -qw net.ipv4.ip_forward=0
ExecStart=/usr/sbin/nft -f /etc/wificorrect/guvenlik.nft
ExecStart=/usr/sbin/nft -f /etc/wificorrect/kapi.nft
# Hız sayaçları ve yavaşlatma sınıfları (yalnızca sayar/işaretler); yüklenemezse açılış durmaz
ExecStart=-/usr/sbin/nft -f /etc/wificorrect/hiz.nft
# Kurallardan önce açılmış bağlantı kayıtları yeni NAT/kapı kurallarından geçmemiştir → temizle
# Bayt sayacı ve süre (5651 trafik kaydı); conntrack modülü artık yüklü
ExecStartPost=/usr/sbin/sysctl -q -p /etc/wificorrect/conntrack.sysctl
ExecStartPost=-/usr/sbin/conntrack -F
# Kayıtlı oturumları ve izinli/yasaklı cihazları kapıya geri yükle (müşteri tekrar SMS istemez)
ExecStartPost=-/usr/local/bin/wificorrect ctl yukle
# Yasaklı siteler / kelimeler (panel); hata açılışı durdurmaz
ExecStartPost=-/usr/local/bin/wificorrect ctl filtre-uygula
ExecStartPost=/usr/sbin/sysctl -qw net.ipv4.ip_forward=1
# Durdurmak kuralları SİLMEZ (Debian nftables.service'in aksine): servis durunca da kapı kapalı kalır.

[Install]
WantedBy=sysinit.target
