[Unit]
Description=WifiCorrect PPPoE baglantisi (pppd)
# Yalnızca PPPoE açılınca (panel → Portlar ya da giriş sayfasındaki Servis) çalışır: o zaman bağlantı dosyası üretilir;
# kapalıyken dosya yoktur, birim başlamaz. Açık/kapalıyı paket değil program yönetir (ag::switch ve ag::pppoe_uygula →
# systemctl enable / disable --now): postinst bu birimi etkinleştirmez.
ConditionPathExists=/etc/ppp/peers/wificorrect
After=network.target

[Service]
# VLAN varsa <internet portu>.<vlan> arayüzünü kurar; pppd'den sonra (ExecStopPost) kaldırılır
ExecStartPre=/usr/local/bin/wificorrect ctl pppoe-hazirla
ExecStart=/usr/sbin/pppd call wificorrect nodetach
ExecStopPost=/usr/local/bin/wificorrect ctl pppoe-temizle
Restart=always
# pppd bağlantı dosyasındaki maxfail 3 ile 3 başarısız denemeden sonra çıkar; yeniden başlatma aralığı 10 sn'den başlayıp 5 adımda
# 5 dk'ya çıkar (systemd 254+): yanlış kullanıcı adı/parola/kimlik yöntemiyle operatörü saniyede bir yoklayıp hesabı kilitletmeyelim.
# systemd bu sayacı birim kendiliğinden yeniden başladıkça sıfırlamaz (aradaki sağlıklı bağlantılar sayılmaz); her başarılı
# bağlantıdan sonra /etc/ppp/ip-up.d/wificorrect sıfırlar (systemctl reset-failed): sonraki kopmada gecikme yeniden 10 sn.
RestartSec=10
RestartSteps=5
RestartMaxDelaySec=300
# pppd SIGTERM alınca 5 koduyla çıkar (pppd(8) EXIT STATUS): durdurma/yeniden başlatma birimi "failed" yapmasın
SuccessExitStatus=5

[Install]
WantedBy=multi-user.target
