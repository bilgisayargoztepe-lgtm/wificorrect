[Unit]
Description=WifiCorrect yönetim merkezi: GitHub'daki yeni cihaz sürümlerini doğrulayıp depoya alır
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=wcpanel
Group=wcpanel
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /usr/local/lib/wificorrect/surumler.py al
TimeoutStartSec=20min
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/wificorrect/merkez
InaccessiblePaths=/srv
