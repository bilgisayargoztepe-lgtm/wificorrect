#!/bin/sh
# WifiCorrect merkez sunucusu: uzak erişim (WireGuard) + yedek arşivi + sunucu taşıma. Debian/Ubuntu, root.
#   wificorrect-sunucu kur <genel-ad>                  kurar ya da tamamlar (genel-ad: vpn.wificorrect.com; tekrar çalıştırmak güvenli)
#   wificorrect-sunucu yonetici-ekle <ad>              yönetici bilgisayarı (10.99.0.2–9) için bağlantı dosyası üretir
#   wificorrect-sunucu cihaz-ekle <ad> <wg> "<ssh>"    cihazı tanıtır: tünel (10.99.0.10–254) + yalnızca-yazma yedek hesabı
#   wificorrect-sunucu yedek-ekle <ad> "<ssh>"         kayıtlı cihaza yedek hesabı açar / anahtarını değiştirir
#   wificorrect-sunucu liste                           cihazlar/yöneticiler, son el sıkışma, son yedek
#   wificorrect-sunucu tasi-paketle <dosya.tar>        bütün sunucu durumu (anahtarlar, kayıtlar, hesaplar, arşiv) tek dosyaya
#   wificorrect-sunucu tasi-kur <dosya.tar>            yeni sunucuda aynı anahtarlarla ayağa kaldırır; sonra DNS'i yeni IP'ye çevirin
#   wificorrect-sunucu cihaz-kapat <ad>                tüneli ve yedek hesabını kapatır; arşiv kalır (yönetim merkezi çağırır)
#   wificorrect-sunucu yonetici-parola <kullanici>     yonetim.wificorrect.com yönetici hesabı / parolası
# Kurallar: cihazlar birbirine ulaşamaz; yalnızca yöneticiler cihazlara (8443, 22) ulaşır. Yedek tünelden gelir (10.99.0.1),
# her cihaz yalnızca kendi klasörüne yazar, silemez, okuyamaz.
set -eu
CONF=/etc/wireguard/wg0.conf
DIR=/etc/wireguard/wificorrect
KAYIT=$DIR/kayit.csv               # tur;ad;ip;wg-acik-anahtar;yedek-kullanicisi[;bitis] (tur: yonetici|cihaz|bitti)
ARSIV=/srv/wificorrect-arsiv       # <ad>/veri: cihazın yedeği; <ad>/.ssh: yalnızca root yazar
PORT=51820
NET=10.99.0

kullanim() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
ad_kontrol() { printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9-]{0,30}$' || { echo "ad: küçük harf, rakam, tire (1-31), ör. bocafe-kadikoy" >&2; exit 2; }; }
bos_adres() { # $1=ilk $2=son
	i=$1
	while [ "$i" -le "$2" ]; do
		grep -q "AllowedIPs = $NET.$i/32" "$CONF" || { echo "$NET.$i"; return; }
		i=$((i + 1))
	done
	echo "adres kalmadı" >&2; exit 1
}
# Dosyadaki eşleri çalışan tünele uygular (bağlı olanlar kopmaz)
uygula() { wg-quick strip wg0 > "$DIR/.strip"; wg syncconf wg0 "$DIR/.strip"; rm -f "$DIR/.strip"; }

# Cihazın yedek hesabı: kabuğu sh ama SSH anahtarı rrsync'e zorlanır (yalnızca yazma, silme yok, yalnızca tünelden)
yedek_hesabi() { # $1=ad $2=ip $3=ssh-açık-anahtar
	u="wfc-$1"
	id "$u" >/dev/null 2>&1 || useradd --system --home-dir "$ARSIV/$1" --no-create-home --shell /bin/sh "$u"
	usermod -p '*' "$u" # parolasız ama kilitli değil (sshd anahtar girişini reddetmesin)
	install -d -m 755 -o root -g root "$ARSIV" "$ARSIV/$1" "$ARSIV/$1/.ssh"
	install -d -m 700 -o "$u" -g "$u" "$ARSIV/$1/veri"
	printf 'restrict,from="%s",command="/usr/bin/rrsync -wo -no-del -munge %s/%s/veri" %s\n' "$2" "$ARSIV" "$1" "$3" > "$ARSIV/$1/.ssh/authorized_keys"
	chmod 644 "$ARSIV/$1/.ssh/authorized_keys"
}

case "${1:-}" in
kur)
	# Ubuntu 26.04'te wg-quick kısıtlı çalışır (PostUp içinden sysctl / nft "permission denied") → ikisi ayrı yerde.
	[ $# -eq 2 ] || kullanim
	apt-get install -y --no-install-recommends wireguard-tools nftables rsync openssh-server >/dev/null
	umask 077
	mkdir -p "$DIR"
	[ -s "$DIR/sunucu.key" ] || wg genkey > "$DIR/sunucu.key"
	wg pubkey < "$DIR/sunucu.key" > "$DIR/sunucu.pub"
	echo "$2:$PORT" > "$DIR/uc-nokta"
	touch "$KAYIT"
	# eski betikle (wg-sunucu.sh) eklenmiş eşler kayda aktarılır
	if [ ! -s "$KAYIT" ] && [ -f "$CONF" ]; then
		awk '/^# (cihaz|yonetici) /{tur=$2; ad=$3} /^PublicKey/{pub=$3} /^AllowedIPs/{split($3,a,"/"); if(tur!="") print tur";"ad";"a[1]";"pub";"; tur=""}' "$CONF" > "$KAYIT"
	fi
	if [ -f "$CONF" ]; then
		sed -i '/^PostUp/d;/^PostDown/d' "$CONF"
	else
		cat > "$CONF" <<EOF
# WifiCorrect merkez sunucusu (wificorrect-sunucu). Eşler aşağıya eklenir.
[Interface]
Address = $NET.1/24
ListenPort = $PORT
PrivateKey = $(cat "$DIR/sunucu.key")
EOF
	fi
	cat > "$DIR/yonlendirme.nft" <<EOF
table inet wfc_vpn
delete table inet wfc_vpn
table inet wfc_vpn {
	chain forward {
		type filter hook forward priority filter - 5; policy accept;
		# yönetici (.2–.9) → cihaz: yalnızca panel ve SSH; cevaplar geçer; cihaz ↔ cihaz ve tünelden dışarı yok
		ct state established,related accept
		iifname "wg0" oifname "wg0" ip saddr $NET.2-$NET.9 tcp dport { 22, 8443 } accept
		iifname "wg0" oifname "wg0" ip saddr $NET.2-$NET.9 icmp type echo-request accept
		iifname "wg0" drop
	}
}
EOF
	echo 'net.ipv4.ip_forward = 1' > /etc/sysctl.d/99-wificorrect-vpn.conf
	sysctl -q -p /etc/sysctl.d/99-wificorrect-vpn.conf
	cat > /etc/systemd/system/wificorrect-vpn.service <<EOF
[Unit]
Description=WifiCorrect uzak erisim yonlendirme kurali (yalnizca yonetici -> cihaz)
After=network-pre.target
Before=wg-quick@wg0.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f $DIR/yonlendirme.nft
ExecStop=/usr/sbin/nft delete table inet wfc_vpn

[Install]
WantedBy=multi-user.target
EOF
	install -d -m 755 -o root -g root "$ARSIV"
	systemctl daemon-reload
	systemctl enable wificorrect-vpn.service wg-quick@wg0 >/dev/null 2>&1
	systemctl restart wificorrect-vpn.service wg-quick@wg0
	if command -v ufw >/dev/null 2>&1 && ufw status | grep -q "Status: active"; then ufw allow $PORT/udp >/dev/null; echo "ufw: $PORT/udp açıldı"; fi
	echo "Kuruldu: tünel $(systemctl is-active wg-quick@wg0), yönlendirme kuralı $(systemctl is-active wificorrect-vpn.service), arşiv $ARSIV"
	echo "DNS: $2 → bu sunucunun genel IP'si; modemde UDP $PORT bu sunucuya yönlendirilmeli."
	echo "Sunucu: $2:$PORT   Açık anahtar: $(cat "$DIR/sunucu.pub")"
	;;
yonetici-ekle)
	[ $# -eq 2 ] || kullanim
	ad_kontrol "$2"
	grep -q "^yonetici;$2;" "$KAYIT" && { echo "$2 zaten var" >&2; exit 1; }
	ip=$(bos_adres 2 9)
	umask 077
	key=$(wg genkey); pub=$(printf '%s' "$key" | wg pubkey)
	printf '\n# yonetici %s\n[Peer]\nPublicKey = %s\nAllowedIPs = %s/32\n' "$2" "$pub" "$ip" >> "$CONF"
	echo "yonetici;$2;$ip;$pub;" >> "$KAYIT"
	uygula
	out="$DIR/yonetici-$2.conf"
	cat > "$out" <<EOF
# WifiCorrect yönetici bağlantısı: $2 ($ip). WireGuard uygulamasına "dosyadan içe aktar".
[Interface]
PrivateKey = $key
Address = $ip/32

[Peer]
PublicKey = $(cat "$DIR/sunucu.pub")
Endpoint = $(cat "$DIR/uc-nokta")
AllowedIPs = $NET.0/24
PersistentKeepalive = 25
EOF
	echo "Yönetici eklendi: $2 = $ip"
	echo "Bağlantı dosyası (gizli anahtar içerir, güvenli taşıyın, sonra silin): $out"
	;;
cihaz-ekle)
	[ $# -eq 4 ] || kullanim
	ad_kontrol "$2"
	printf '%s' "$3" | grep -Eq '^[A-Za-z0-9+/]{43}=$' || { echo "WireGuard anahtarı geçersiz (44 karakter, = ile biter)" >&2; exit 2; }
	printf '%s' "$4" | grep -Eq '^ssh-ed25519 [A-Za-z0-9+/]+=*( [A-Za-z0-9@._-]+)?$' || { echo "SSH anahtarı geçersiz (ssh-ed25519 …)" >&2; exit 2; }
	grep -q "^cihaz;$2;" "$KAYIT" && { echo "$2 zaten var" >&2; exit 1; }
	sed -i "/^bitti;$2;/d" "$KAYIT"   # biten kayıt yeniden açılıyor: arşiv ve yedek klasörü korunur
	grep -q "PublicKey = $3" "$CONF" && { echo "bu WireGuard anahtarı zaten ekli" >&2; exit 1; }
	ip=$(bos_adres 10 254)
	printf '\n# cihaz %s\n[Peer]\nPublicKey = %s\nAllowedIPs = %s/32\n' "$2" "$3" "$ip" >> "$CONF"
	yedek_hesabi "$2" "$ip" "$4"
	echo "cihaz;$2;$ip;$3;wfc-$2" >> "$KAYIT"
	uygula
	echo "Cihaz eklendi: $2 = $ip"
	echo "Cihazın panelinde Admin ayarları:"
	echo "  Uzak erişim → Sunucu:                  $(cat "$DIR/uc-nokta")"
	echo "  Uzak erişim → Sunucunun açık anahtarı: $(cat "$DIR/sunucu.pub")"
	echo "  Uzak erişim → Bu cihazın tünel adresi: $ip"
	echo "  Uzak yedek  → Yedek hedefi:            wfc-$2@$NET.1:"
	echo "Panel: https://$ip:8443   SSH: ssh root@$ip"
	;;
yedek-ekle)
	[ $# -eq 3 ] || kullanim
	printf '%s' "$3" | grep -Eq '^ssh-ed25519 [A-Za-z0-9+/]+=*( [A-Za-z0-9@._-]+)?$' || { echo "SSH anahtarı geçersiz (ssh-ed25519 …)" >&2; exit 2; }
	satir=$(grep "^cihaz;$2;" "$KAYIT") || { echo "$2 kayıtlı cihaz değil (önce cihaz-ekle)" >&2; exit 1; }
	ip=$(printf '%s' "$satir" | cut -d';' -f3)
	ad_k=$(printf '%s' "$2" | tr 'A-Z' 'a-z')
	yedek_hesabi "$ad_k" "$ip" "$3"
	awk -F';' -v OFS=';' -v a="$2" -v u="wfc-$ad_k" '$1=="cihaz" && $2==a {$5=u} {print}' "$KAYIT" > "$KAYIT.yeni" && mv "$KAYIT.yeni" "$KAYIT"
	echo "Yedek hesabı: wfc-$ad_k ($ip'den, yalnızca yazma). Cihazın Admin ayarları → Yedek hedefi: wfc-$ad_k@$NET.1:"
	;;
liste)
	now=$(date +%s)
	printf '%-9s %-24s %-14s %-18s %s\n' TUR AD TUNEL "SON EL SIKISMA" "SON YEDEK"
	while IFS=';' read -r tur ad ip pub u tarih; do
		[ -n "$tur" ] || continue
		t=$(wg show wg0 latest-handshakes | awk -v p="$pub" '$1==p{print $2}')
		if [ -z "$t" ] || [ "$t" = 0 ]; then d="hiç"; else d="$(( (now - t) / 60 )) dk önce"; fi
		y="-"
		[ "$tur" = bitti ] && d="bitti $tarih"
		if { [ "$tur" = cihaz ] || [ "$tur" = bitti ]; } && [ -n "$u" ]; then
			y=$(find "$ARSIV/${u#wfc-}/veri" -type f -printf '%TY-%Tm-%Td %TH:%TM\n' 2>/dev/null | sort | tail -1)
			[ -n "$y" ] || y="henüz yok"
		fi
		printf '%-9s %-24s %-14s %-18s %s\n' "$tur" "$ad" "$ip" "$d" "$y"
	done < "$KAYIT"
	;;
tasi-paketle)
	[ $# -eq 2 ] || kullanim
	umask 077
	ek=""; for p in var/lib/wificorrect srv/hotspot-arsiv etc/caddy/Caddyfile; do [ -e "/$p" ] && ek="$ek $p"; done
	# shellcheck disable=SC2086
	tar -C / -cpf "$2" etc/wireguard etc/sysctl.d/99-wificorrect-vpn.conf etc/systemd/system/wificorrect-vpn.service "${ARSIV#/}" usr/local/sbin/wificorrect-sunucu $ek
	echo "Paket: $2 ($(du -h "$2" | cut -f1)) — gizli anahtarlar ve kişisel veri içerir, güvenli taşıyın."
	echo "Yönetim merkezi için yeni sunucuda scripts/sunucu/merkez-kur.sh çalıştırın."
	echo "Yeni sunucuda: wificorrect-sunucu tasi-kur $2   ardından DNS'i yeni IP'ye çevirin, UDP $PORT'u yönlendirin."
	;;
tasi-kur)
	[ $# -eq 2 ] || kullanim
	[ -f "$CONF" ] && { echo "Bu sunucuda zaten kurulum var ($CONF); taşıma yalnızca boş sunucuya." >&2; exit 1; }
	apt-get install -y --no-install-recommends wireguard-tools nftables rsync openssh-server >/dev/null
	tar -C / -xpf "$2"
	# yedek hesapları (kullanıcı numaraları yeni sunucuda farklı olabilir → sahiplik ada göre yeniden)
	while IFS=';' read -r tur ad ip pub u tarih; do
		{ [ "$tur" = cihaz ] || [ "$tur" = bitti ]; } && [ -n "$u" ] || continue
		h="$ARSIV/${u#wfc-}"
		id "$u" >/dev/null 2>&1 || useradd --system --home-dir "$h" --no-create-home --shell /bin/sh "$u"
		usermod -p '*' "$u"
		chown root:root "$h" "$h/.ssh" "$h/.ssh/authorized_keys"
		chown -R "$u:$u" "$h/veri"
	done < "$KAYIT"
	sysctl -q -p /etc/sysctl.d/99-wificorrect-vpn.conf
	systemctl daemon-reload
	systemctl enable wificorrect-vpn.service wg-quick@wg0 >/dev/null 2>&1
	systemctl restart wificorrect-vpn.service wg-quick@wg0
	if command -v ufw >/dev/null 2>&1 && ufw status | grep -q "Status: active"; then ufw allow $PORT/udp >/dev/null; fi
	id wcpanel >/dev/null 2>&1 && chown -R wcpanel:wcpanel /var/lib/wificorrect/merkez /var/lib/wificorrect/kuyruk 2>/dev/null || true
	echo "Taşındı: $(grep -c '^cihaz;' "$KAYIT") cihaz, $(grep -c '^yonetici;' "$KAYIT") yönetici. Tünel $(systemctl is-active wg-quick@wg0)."
	echo "Şimdi: $(cut -d: -f1 "$DIR/uc-nokta") → bu sunucunun genel IP'si (DNS) ve modemde UDP $PORT. Cihazlar 10 dk içinde bağlanır."
	;;
cihaz-kapat)
	[ $# -eq 2 ] || kullanim
	# eski (elle eklenmiş) kayıtlarda büyük harf olabilir: yalnızca harf/rakam/tire/nokta/alt çizgi; satır kayıtta olmalı
	printf '%s' "$2" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]{0,40}$' || { echo "geçersiz ad: $2" >&2; exit 2; }
	satir=$(awk -F';' -v a="$2" '$1=="cihaz" && $2==a {print; exit}' "$KAYIT"); [ -n "$satir" ] || { echo "$2 aktif bir cihaz değil" >&2; exit 1; }
	pub=$(printf '%s' "$satir" | cut -d';' -f4)
	u=$(printf '%s' "$satir" | cut -d';' -f5)
	# WireGuard eşi: "# cihaz <ad>" satırı ve ardından gelen [Peer] / PublicKey / AllowedIPs satırları çıkar
	awk -v a="# cihaz $2" '$0==a{atla=1;next} atla&&/^(\[Peer\]|PublicKey = |AllowedIPs = |PersistentKeepalive = )/{next} {atla=0;print}' "$CONF" > "$CONF.yeni"
	if grep -qF "PublicKey = $pub" "$CONF.yeni"; then rm -f "$CONF.yeni"; echo "eş çıkarılamadı, wg0.conf'a dokunulmadı" >&2; exit 1; fi
	chmod 600 "$CONF.yeni" && mv "$CONF.yeni" "$CONF"
	uygula
	[ -n "$u" ] && : > "$ARSIV/${u#wfc-}/.ssh/authorized_keys"
	awk -F';' -v OFS=';' -v a="$2" -v t="$(date +%F)" '$1=="cihaz" && $2==a {$1="bitti"; print $0, t; next} {print}' "$KAYIT" > "$KAYIT.yeni" && mv "$KAYIT.yeni" "$KAYIT"
	echo "Cihaz kapatıldı: $2 (tünel ve yedek kapalı; arşiv duruyor)"
	;;
yonetici-parola)
	[ $# -eq 2 ] || kullanim
	exec /usr/local/bin/wificorrect-merkez yonetici parola "$2"
	;;
*) kullanim ;;
esac
